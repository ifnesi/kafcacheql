<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ifnesi</groupId>
  <artifactId>kafcacheql-jdbc</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>KafCacheQL</name>
  <description>Read-only JDBC driver that queries Kafka topics through an incremental local SQLite cache.</description>
  <url>https://github.com/ifnesi/kafcacheql</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/ifnesi/kafcacheql</url>
    <connection>scm:git:https://github.com/ifnesi/kafcacheql.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Confluent's serializers and the kafka-clients build they are made against. -->
    <confluent.version>8.4.0</confluent.version>
    <kafka.version>${confluent.version}-ccs</kafka.version>
    <jackson.version>2.22.3</jackson.version>
    <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
    <jsqlparser.version>5.4</jsqlparser.version>
    <guava.version>33.8.0-jre</guava.version>
    <protobuf.version>4.36.2</protobuf.version>
    <jline.version>4.7.0</jline.version>
    <slf4j.version>2.0.20</slf4j.version>
    <junit.version>6.1.3</junit.version>
    <hikaricp.version>7.1.0</hikaricp.version>
    <spring.version>7.1.0</spring.version>

    <!-- Relocated packages live under this prefix in the shaded JAR. -->
    <shade.prefix>io.github.ifnesi.kafcacheql.shaded</shade.prefix>
    <skipITs>false</skipITs>
    <test.heap>1g</test.heap>
  </properties>

  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Convergence pins: the highest version any path asks for. -->
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.52.0</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.squareup.okio</groupId>
        <artifactId>okio-jvm</artifactId>
        <version>3.17.0</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib</artifactId>
        <version>2.3.10</version>
      </dependency>
      <dependency>
        <groupId>joda-time</groupId>
        <artifactId>joda-time</artifactId>
        <version>2.12.7</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.re2j</groupId>
        <artifactId>re2j</artifactId>
        <version>1.8</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.28.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-reader</artifactId>
      <version>${jline.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal-jni</artifactId>
      <version>${jline.version}</version>
    </dependency>
    <!-- Already supplied by Confluent; used directly for offset range sets. -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>${guava.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.version}</version>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-schema-registry-client</artifactId>
      <version>${confluent.version}</version>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
      <version>${confluent.version}</version>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-json-schema-serializer</artifactId>
      <version>${confluent.version}</version>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-protobuf-serializer</artifactId>
      <version>${confluent.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.jsqlparser</groupId>
      <artifactId>jsqlparser</artifactId>
      <version>${jsqlparser.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>${spring.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
      <version>${spring.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>META-INF/jline/providers/**</exclude>
          <exclude>io/github/ifnesi/kafcacheql/driver/version.txt</exclude>
        </excludes>
      </resource>
      <!-- Filter the build version and JLine's provider indexes (outside Java's service-file location). -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/jline/providers/**</include>
          <include>io/github/ifnesi/kafcacheql/driver/version.txt</include>
        </includes>
      </resource>
    </resources>
    <!-- A fixed file name: the demo and the docs point at target/kafcacheql-jdbc.jar whatever the version. -->
    <finalName>kafcacheql-jdbc</finalName>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <!-- Without it, a build without `clean` keeps the last shaded JAR as the project's JAR, and
                 shade processes its own output again. -->
            <forceCreation>true</forceCreation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!-- Two versions of one library in the tree, kafka-clients above all, fail the build. -->
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Unit tests: *Test. Integration tests (*IT) are failsafe's, even when named Test*IT. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Keep native extractions from killed test JVMs off RAM-backed /tmp. -->
          <argLine>-Xmx${test.heap} -Djava.io.tmpdir="${project.build.directory}"</argLine>
          <systemPropertyVariables>
            <projectVersion>${project.version}</projectVersion>
          </systemPropertyVariables>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- A different kafka-clients for DriverManagerIT to load beside the shaded JAR. Copied, not a
           dependency, so it stays out of the project's tree. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>it-libs</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <skip>${skipITs}</skip>
              <outputDirectory>${project.build.directory}/it-libs</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.apache.kafka</groupId>
                  <artifactId>kafka-clients</artifactId>
                  <version>3.9.1</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Integration tests: *IT, after packaging, so they can check the shaded JAR.
           Skip them with -DskipITs (no Docker stack needed then). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- The unshaded classes, as unit tests use them: the main artifact is the shaded JAR, whose
               relocated Kafka types the tests weren't compiled against. ShadedJarIT, DriverManagerIT and
               ShadedLoginIT load the shaded JAR themselves. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          <argLine>-Xmx${test.heap} -Djava.io.tmpdir="${project.build.directory}"</argLine>
          <systemPropertyVariables>
            <projectVersion>${project.version}</projectVersion>
            <shadedJar>${project.build.directory}/${project.build.finalName}.jar</shadedJar>
            <otherKafkaClients>${project.build.directory}/it-libs/kafka-clients-3.9.1.jar</otherKafkaClients>
            <!-- ShadedJarIT's isolated class loader has no SLF4J provider; that is expected, not news. -->
            <slf4j.internal.verbosity>ERROR</slf4j.internal.verbosity>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- The shaded JAR replaces the plain one. JNI libraries are not relocated:
           their native symbols are tied to their package names (sqlite-jdbc, zstd-jni,
           snappy-java, lz4-java). SLF4J is not relocated, so logs reach the host's provider. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/DEPENDENCIES</exclude>
                    <!-- Shade doesn't relocate multi-release copies; the relocated base classes run on Java 21. -->
                    <exclude>META-INF/versions/*/com/fasterxml/**</exclude>
                    <exclude>META-INF/versions/*/org/yaml/**</exclude>
                    <exclude>META-INF/versions/*/kotlin/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.jline:jline-native</artifact>
                  <includes>
                    <include>**/*.class</include>
                    <include>META-INF/**</include>
                    <include>org/jline/nativ/jlinenative.properties</include>
                    <include>org/jline/nativ/Linux/x86_64/**</include>
                    <include>org/jline/nativ/Linux/arm64/**</include>
                    <include>org/jline/nativ/Linux-musl/x86_64/**</include>
                    <include>org/jline/nativ/Linux-musl/arm64/**</include>
                    <include>org/jline/nativ/Mac/x86_64/**</include>
                    <include>org/jline/nativ/Mac/arm64/**</include>
                    <include>org/jline/nativ/Windows/x86_64/**</include>
                    <include>org/jline/nativ/Windows/arm64/**</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>org.jline:*</artifact>
                  <excludes><exclude>META-INF/jline/providers/**</exclude></excludes>
                </filter>
                <!-- Keep Wire's schema-loader resources; protobuf-java uses compiled descriptors. -->
                <filter>
                  <artifact>com.google.protobuf:protobuf-java</artifact>
                  <excludes>
                    <exclude>google/protobuf/*.proto</exclude>
                  </excludes>
                </filter>
                <!-- The driver opens SQLite directly; only KafCacheQL registers with DriverManager. -->
                <filter>
                  <artifact>org.xerial:sqlite-jdbc</artifact>
                  <includes>
                    <include>**/*.class</include>
                    <include>META-INF/**</include>
                    <include>sqlite-jdbc.properties</include>
                    <include>org/sqlite/native/Linux/x86_64/**</include>
                    <include>org/sqlite/native/Linux/aarch64/**</include>
                    <include>org/sqlite/native/Linux-Musl/x86_64/**</include>
                    <include>org/sqlite/native/Linux-Musl/aarch64/**</include>
                    <include>org/sqlite/native/Mac/x86_64/**</include>
                    <include>org/sqlite/native/Mac/aarch64/**</include>
                    <include>org/sqlite/native/Windows/x86_64/**</include>
                    <include>org/sqlite/native/Windows/aarch64/**</include>
                  </includes>
                  <excludes>
                    <exclude>META-INF/services/java.sql.Driver</exclude>
                  </excludes>
                </filter>
                <!-- Keep all classes/metadata and only Linux, macOS and Windows x86-64/ARM64 natives.
                     Available Linux musl builds are included; lz4-java has no Windows ARM64 native. -->
                <filter>
                  <artifact>com.github.luben:zstd-jni</artifact>
                  <includes>
                    <include>**/*.class</include>
                    <include>META-INF/**</include>
                    <include>linux/amd64/**</include>
                    <include>linux/aarch64/**</include>
                    <include>darwin/x86_64/**</include>
                    <include>darwin/aarch64/**</include>
                    <include>win/amd64/**</include>
                    <include>win/aarch64/**</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>org.xerial.snappy:snappy-java</artifact>
                  <includes>
                    <include>**/*.class</include>
                    <include>META-INF/**</include>
                    <include>org/xerial/snappy/VERSION</include>
                    <include>org/xerial/snappy/native/README</include>
                    <include>org/xerial/snappy/native/Linux/x86_64/**</include>
                    <include>org/xerial/snappy/native/Linux/aarch64/**</include>
                    <include>org/xerial/snappy/native/Linux/x86_64-musl/**</include>
                    <include>org/xerial/snappy/native/Mac/x86_64/**</include>
                    <include>org/xerial/snappy/native/Mac/aarch64/**</include>
                    <include>org/xerial/snappy/native/Windows/x86_64/**</include>
                    <include>org/xerial/snappy/native/Windows/aarch64/**</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>at.yawk.lz4:lz4-java</artifact>
                  <includes>
                    <include>**/*.class</include>
                    <include>META-INF/**</include>
                    <include>net/jpountz/util/linux/amd64/**</include>
                    <include>net/jpountz/util/linux/aarch64/**</include>
                    <include>net/jpountz/util/darwin/x86_64/**</include>
                    <include>net/jpountz/util/darwin/aarch64/**</include>
                    <include>net/jpountz/util/windows/amd64/**</include>
                  </includes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>org.jline</pattern>
                  <shadedPattern>${shade.prefix}.org.jline</shadedPattern>
                  <!-- JNI symbols and native resource paths name this package. -->
                  <excludes><exclude>org.jline.nativ.**</exclude></excludes>
                </relocation>
                <relocation>
                  <pattern>org.apache.kafka</pattern>
                  <shadedPattern>${shade.prefix}.org.apache.kafka</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.confluent</pattern>
                  <shadedPattern>${shade.prefix}.io.confluent</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.avro</pattern>
                  <shadedPattern>${shade.prefix}.org.apache.avro</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>${shade.prefix}.com.fasterxml.jackson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.sf.jsqlparser</pattern>
                  <shadedPattern>${shade.prefix}.net.sf.jsqlparser</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.google</pattern>
                  <shadedPattern>${shade.prefix}.com.google</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.squareup</pattern>
                  <shadedPattern>${shade.prefix}.com.squareup</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.palantir.javapoet</pattern>
                  <shadedPattern>${shade.prefix}.com.palantir.javapoet</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>okio</pattern>
                  <shadedPattern>${shade.prefix}.okio</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.commons</pattern>
                  <shadedPattern>${shade.prefix}.org.apache.commons</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.hc</pattern>
                  <shadedPattern>${shade.prefix}.org.apache.hc</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.yaml.snakeyaml</pattern>
                  <shadedPattern>${shade.prefix}.org.yaml.snakeyaml</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.swagger</pattern>
                  <shadedPattern>${shade.prefix}.io.swagger</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.eclipsesource.json</pattern>
                  <shadedPattern>${shade.prefix}.com.eclipsesource.json</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.jspecify</pattern>
                  <shadedPattern>${shade.prefix}.org.jspecify</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>javax.annotation</pattern>
                  <shadedPattern>${shade.prefix}.javax.annotation</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.everit</pattern>
                  <shadedPattern>${shade.prefix}.org.everit</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.json</pattern>
                  <shadedPattern>${shade.prefix}.org.json</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.damnhandy</pattern>
                  <shadedPattern>${shade.prefix}.com.damnhandy</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.github.erosb</pattern>
                  <shadedPattern>${shade.prefix}.com.github.erosb</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.sanctionco</pattern>
                  <shadedPattern>${shade.prefix}.com.sanctionco</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.joda</pattern>
                  <shadedPattern>${shade.prefix}.org.joda</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.kjetland</pattern>
                  <shadedPattern>${shade.prefix}.com.kjetland</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>javax.validation</pattern>
                  <shadedPattern>${shade.prefix}.javax.validation</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.github.classgraph</pattern>
                  <shadedPattern>${shade.prefix}.io.github.classgraph</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>nonapi.io.github.classgraph</pattern>
                  <shadedPattern>${shade.prefix}.nonapi.io.github.classgraph</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>kotlin</pattern>
                  <shadedPattern>${shade.prefix}.kotlin</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.intellij</pattern>
                  <shadedPattern>${shade.prefix}.org.intellij</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.jetbrains</pattern>
                  <shadedPattern>${shade.prefix}.org.jetbrains</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.ifnesi.kafcacheql.cli.Main</mainClass>
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    <Implementation-Title>${project.name}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
